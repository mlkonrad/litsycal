#: prefs.js:500
msgid ""
"Uses strftime format codes:\n"
"\n"
"%d  — Day number (01–31)\n"
"%m  — Month number (01–12)\n"
"%b  — Month abbrev (Jan, Feb…)\n"
"%a  — Weekday abbrev (Mon, Tue…)\n"
"%Y  — Full year (2026)\n"
"%H  — Hour, 24-hour (00–23)\n"
"%I  — Hour, 12-hour (01–12)\n"
"%M  — Minutes (00–59)\n"
"%P  — am or pm\n"
"\n"
"Examples:\n"
"  %d/%m       → 03/05\n"
"  %a %d       → Sun 03\n"
"  %d %b %Y    → 03 May 2026\n"
"  %H:%M       → 13:05\n"
"  %-I:%M%P    → 1:05pm\n"
"  %d %H:%M    → 03 13:05"
msgstr ""
"Usa códigos de formato strftime:\n"
"\n"
"%d  — Número do dia (01–31)\n"
"%m  — Número do mês (01–12)\n"
"%b  — Mês abreviado (jan, fev…)\n"
"%a  — Dia da semana abreviado (dom, seg…)\n"
"%Y  — Ano completo (2026)\n"
"%H  — Hora, 24 horas (00–23)\n"
"%I  — Hora, 12 horas (01–12)\n"
"%M  — Minutos (00–59)\n"
"%P  — am ou pm\n"
"\n"
"Exemplos:\n"
"  %d/%m       → 03/05\n"
"  %a %d       → dom 03\n"
"  %d %b %Y    → 03 mai 2026\n"
"  %H:%M       → 13:05\n"
"  %-I:%M%P    → 1:05pm\n"
"  %d %H:%M    → 03 13:05"

